{
  "name": "twynix-factory-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env apps/server/src/main.ts",
    "dev:web": "ng serve web --host 127.0.0.1",
    "build": "npm run typecheck && ng build web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "start": "tsx --env-file-if-exists=.env apps/server/src/main.ts",
    "format": "prettier --write \"apps/**/*.{ts,html,scss,json}\" \"packages/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\"",
    "setup": "node scripts/setup.mjs",
    "mcp": "tsx --env-file-if-exists=.env apps/mcp/src/main.ts",
    "docker:setup": "node scripts/docker-setup.mjs"
  },
  "dependencies": {
    "@angular/animations": "^22.2.4",
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/material": "^22.2.0",
    "@angular/platform-browser": "^22.2.4",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.0.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "better-sqlite3": "^12.0.0",
    "fastify": "^5.0.0",
    "node-opcua": "^2.170.0",
    "pino": "^10.0.0",
    "rxjs": "^7.8.2",
    "tsx": "^4.23.15",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.4",
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "1.56.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.6.0",
    "typescript": "~6.0.0",
    "vitest": "4.1.12"
  }
}

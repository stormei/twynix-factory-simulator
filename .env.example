HOST=127.0.0.1
PORT=3000
OPCUA_HOST=localhost
OPCUA_PORT=4840
# Secure default: supply a unique password before startup.
OPCUA_PASSWORD=replace-with-a-long-unique-password
OPCUA_USER=operator
# Set true only for isolated local development; enables unsecured transport and anonymous reads, never anonymous writes.
OPCUA_DEV=false
DATA_DIR=./data
# Required for Docker or any non-loopback API binding.
API_TOKEN=replace-with-a-long-random-access-token

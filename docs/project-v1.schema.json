{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,80}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "seed": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "weather": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "manual",
            "forecast"
          ]
        },
        "site": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "tilt": {
              "type": "number",
              "minimum": 0,
              "maximum": 90
            },
            "azimuth": {
              "type": "number",
              "minimum": 0,
              "maximum": 360
            }
          },
          "required": [
            "name",
            "latitude",
            "longitude",
            "tilt",
            "azimuth"
          ],
          "additionalProperties": false
        },
        "startTime": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "forecast": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "const": "Open-Meteo"
            },
            "fetchedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "samples": {
              "minItems": 2,
              "maxItems": 192,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "time": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4102444800
                  },
                  "irradiance": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2200
                  },
                  "temperature": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 65
                  },
                  "cloudCover": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "time",
                  "irradiance",
                  "temperature",
                  "cloudCover"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "provider",
            "fetchedAt",
            "samples"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "mode",
        "site",
        "startTime"
      ],
      "additionalProperties": false
    },
    "equipment": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "source",
              "tank",
              "pump",
              "valve",
              "pipe",
              "flow-sensor",
              "level-sensor",
              "pressure-sensor",
              "conveyor",
              "motor",
              "photo-sensor",
              "machine",
              "counter",
              "material-source",
              "buffer",
              "inspection",
              "sink",
              "pv-array",
              "kaco-inverter",
              "grid-meter"
            ]
          },
          "tag": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "label": {
            "type": "string",
            "maxLength": 100
          },
          "x": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          },
          "y": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          },
          "mode": {
            "type": "string",
            "enum": [
              "manual",
              "automatic",
              "external"
            ]
          },
          "parameters": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "number"
            }
          },
          "commands": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": [
                "number",
                "boolean"
              ]
            }
          },
          "faults": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "trip",
                "fail-start",
                "stuck-open",
                "stuck-closed",
                "stuck",
                "drift",
                "jam",
                "overheat",
                "invalid",
                "leak"
              ]
            }
          }
        },
        "required": [
          "id",
          "type",
          "tag",
          "label",
          "x",
          "y",
          "mode",
          "parameters",
          "commands",
          "faults"
        ],
        "additionalProperties": false
      }
    },
    "connections": {
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string"
          },
          "fromPort": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "toPort": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "from",
          "fromPort",
          "to",
          "toPort"
        ],
        "additionalProperties": false
      }
    },
    "controllers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "tank": {
            "type": "string"
          },
          "pump": {
            "type": "string"
          },
          "low": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "high": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "tank",
          "pump",
          "low",
          "high",
          "enabled"
        ],
        "additionalProperties": false
      }
    },
    "scenarios": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "number",
            "minimum": 0
          },
          "equipmentId": {
            "type": "string"
          },
          "fault": {
            "type": "string",
            "enum": [
              "trip",
              "fail-start",
              "stuck-open",
              "stuck-closed",
              "stuck",
              "drift",
              "jam",
              "overheat",
              "invalid",
              "leak"
            ]
          },
          "active": {
            "type": "boolean"
          }
        },
        "required": [
          "at",
          "equipmentId",
          "fault",
          "active"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "seed",
    "equipment",
    "connections",
    "controllers",
    "scenarios"
  ],
  "additionalProperties": false
}
